# Copy to .env.local:  cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (same keys)

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 — leave as placeholder until production
NEXT_PUBLIC_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# ── Strapi CMS (server-side only — NEVER prefix with NEXT_PUBLIC_) ──
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
# Shared secret for Strapi webhook → /api/revalidate
STRAPI_REVALIDATE_SECRET=

# ── SendGrid (contact form → /api/contact) ────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CONTACT_TO_EMAIL=
